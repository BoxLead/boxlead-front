# Copy to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars.

aws_region   = "us-east-2"
bucket_name  = "signal-front-your-unique-name"
domain_name  = "boxlead.app"

# Must match GitHub Actions env SIGNAL_FRONT_SSM_PREFIX in deploy.yml (default /signal-front/)
# ssm_prefix = "/signal-front/"

# Backend API URL — written to SSM as VITE_API_BASE_URL for the CI build (must be HTTPS for browser mixed-content rules)
api_base_url = "https://api.boxlead.app"

# PriceClass_100 = US/EU only (cheapest); PriceClass_All = global
price_class = "PriceClass_100"

# Auth0 application for Google and Facebook login — written to SSM as VITE_AUTH0_DOMAIN / VITE_AUTH0_CLIENT_ID for the CI build.
# Both are public values. Leave empty to hide the social login buttons.
auth0_domain    = "login.boxlead.app"
auth0_client_id = "your-auth0-application-client-id"

# Google Analytics 4 measurement id — written to SSM as VITE_GA_MEASUREMENT_ID for the CI build. Public value.
# Leave empty to ship no analytics. The public pages ask for consent before loading the tag and /app never loads it.
# ga_measurement_id = "G-XXXXXXXXXX"

# Search Console verification token for a meta tag — written to SSM as VITE_GOOGLE_SITE_VERIFICATION. Prefer the DNS record.
# google_site_verification = ""

# Backoffice on its own bucket and CloudFront distribution, behind Cloudflare Access.
# admin_domain_name = "admin.boxlead.app"
# admin_bucket_name = ""

# Header the Cloudflare transform rule adds toward the admin distribution. Requests without it get 403.
# Both are sensitive. Keep them in Terraform Cloud as sensitive variables, never in this file.
admin_origin_header_name  = "x-origin-header-name"
admin_origin_header_value = "replace-with-openssl-rand-hex-32-output"
# Only during a rotation, see README.
# admin_origin_header_previous_value = ""
