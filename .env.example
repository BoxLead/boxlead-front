# Leave unset in development to use the Vite proxy (/api -> http://localhost:8080,
# /agent-api -> http://localhost:8000).
# For production or direct API calls, set the full origins, e.g.:
# VITE_API_BASE_URL=https://api.boxlead.app
# VITE_AGENT_API_BASE_URL=https://agent.boxlead.app
# Google Analytics 4 measurement id. Leave unset to ship no analytics at all.
# With a value, the public pages ask for consent before loading the tag and
# /app never loads it.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Search Console verification through a meta tag. Prefer the DNS record and
# leave this unset.
# VITE_GOOGLE_SITE_VERIFICATION=
